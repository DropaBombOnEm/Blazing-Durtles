<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widgetStreakFlameIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_flame_dim"
        android:contentDescription="@string/streak_icon" />

    <TextView
        android:id="@+id/widgetStreakValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginStart="8dp"
        android:textColor="@color/wkDarkColorPrimary" />

    <TextView
        android:layout_width="16dp"
        android:layout_height="0dp"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetLessonsDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lessons Done: 0"
            android:textSize="16sp"
            android:textColor="@color/wkDarkColorPrimary" />

        <TextView
            android:id="@+id/widgetReviewsDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reviews Done: 0"
            android:textSize="16sp"
            android:textColor="@color/wkDarkColorPrimary" />
    </LinearLayout>
</LinearLayout>
